ASSISTANT_PUBLIC_URL=http://m7:8000
PC_HOST=desktop
PC_HOST_TOKEN=change-me
PC_MAC=
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
GITHUB_TOKEN=
